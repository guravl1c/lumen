{
  "name": "lumen",
  "version": "1.2.0",
  "description": "Lumen — Illuminate understanding. Real-time formative assessment for teachers.",
  "main": "main.js",
  "author": "Андрей",
  "license": "MIT",
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "devDependencies": {
    "electron": "^44.4.5",
    "electron-builder": "^25.1.8"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "electron-log": "^5.2.0",
    "electron-updater": "^6.3.9"
  },
  "build": {
    "appId": "com.lumen.desktop",
    "nodeGypRebuild": false,
    "npmRebuild": false,
    "productName": "Lumen",
    "copyright": "© 2026 Андрей",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "renderer/**/*",
      "src/**/*",
      "bin/**/*",
      "node_modules/better-sqlite3/**/*",
      "node_modules/node-addon-api/**/*",
      "node_modules/electron-updater/**/*",
      "node_modules/electron-log/**/*"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*",
      "bin/**/*"
    ],
    "extraMetadata": {
      "main": "main.js"
    },
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Lumen",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico",
      "deleteAppDataOnUninstall": false
    },
    "publish": {
      "provider": "github",
      "owner": "guravl1c",
      "repo": "lumen",
      "releaseType": "release"
    }
  }
}